# Supabase project settings (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Server-only — bypasses Row Level Security. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Stripe (Connect platform account)
STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen` locally, or the Event Destination's webhook_endpoint.signing_secret in production
STRIPE_WEBHOOK_SECRET=whsec_...
# Separate signing secret for the v2 thin-events Connect webhook (see CLAUDE.md "Stripe Connect" section)
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Mapbox (server-only geocoding for multi-location delivery — see CLAUDE.md
# "Multi-location delivery" section). Never exposed to the browser.
MAPBOX_TOKEN=pk.ey...

# DoorDash Drive (bring-your-own-account delivery dispatch — see CLAUDE.md
# "DoorDash Drive" section). Restaurant-specific Developer ID/Key ID/Signing
# Secret live in the restaurant_delivery_accounts table, not here. This is a
# single platform-wide value YOU choose (any random string) and paste into
# every restaurant's own DoorDash Developer Portal webhook config — DoorDash
# echoes it back verbatim in the Authorization header on every webhook call,
# proving the request really came from DoorDash (no HMAC scheme here, unlike
# Stripe). /admin/[slug]/delivery shows this value to owners so they can copy
# it into their DoorDash portal.
DOORDASH_WEBHOOK_AUTH_TOKEN=
