# Supabase project settings (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Server-only — bypasses Row Level Security. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Stripe (Connect platform account)
STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen` locally, or the Event Destination's webhook_endpoint.signing_secret in production
STRIPE_WEBHOOK_SECRET=whsec_...
# Separate signing secret for the v2 thin-events Connect webhook (see CLAUDE.md "Stripe Connect" section)
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
